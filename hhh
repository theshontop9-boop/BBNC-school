            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
                <!-- Item 1 -->
                <div class="group bg-gray-50 hover:bg-blue-50/50 border border-gray-100 hover:border-blue-200 transition-all duration-300 p-8 rounded-2xl text-center shadow-sm hover:shadow-md">
                    <div class="w-16 h-16 mx-auto mb-6 bg-blue-100 text-primary rounded-2xl flex items-center justify-center text-3xl group-hover:scale-110 transition duration-300">
