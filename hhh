        <div class="bg-amber-50 border-l-4 border-amber-500 p-6 rounded-2xl shadow-sm flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
            <div class="flex items-start space-x-4">
                <div class="bg-amber-500 text-white p-3 rounded-xl shrink-0 mt-0.5">
                    <i class="fa-solid fa-triangle-exclamation text-xl"></i>
                </div>
                <div>
                    <h3 class="text-amber-900 font-bold text-base sm:text-lg">Important Notice Regarding Eligibility</h3>
